{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "website/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/((?!api/).*\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?))",
      "dest": "/website/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/website/index.html"
    }
  ]
}
